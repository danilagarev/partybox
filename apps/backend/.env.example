# Defaults in src/main.ts. Set environment variables in the shell or deployment.
HOST=127.0.0.1
PORT=3000

# Rooms are disabled when DATABASE_URL is absent. Apply migrations before startup.
# Example local-only database; use separate credentials outside development.
DATABASE_URL=postgresql://partybox:partybox_dev@127.0.0.1:5432/partybox
# Generate once: openssl rand -hex 32. Keep stable across backend restarts.
ROOM_TOKEN_SECRET=
# Optional integration suite (creates/drops an isolated schema in this database).
TEST_DATABASE_URL=postgresql://partybox:partybox_dev@127.0.0.1:5432/partybox
