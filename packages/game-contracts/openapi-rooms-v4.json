{
  "openapi": "3.1.0",
  "info": { "title": "PartyBox — сетевая партия", "version": "4.0.0" },
  "paths": {
    "/v4/rooms": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/V4Enrollment" } }
          }
        },
        "responses": {
          "201": {
            "description": "Принято",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V4EnrollmentResult" }
              }
            }
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Error" } }
            }
          }
        }
      }
    },
    "/v4/rooms/join/{pin}": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "pin",
            "required": true,
            "schema": { "type": "string", "pattern": "^[0-9]{6}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/V4Enrollment" } }
          }
        },
        "responses": {
          "201": {
            "description": "Принято",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V4EnrollmentResult" }
              }
            }
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Error" } }
            }
          }
        }
      }
    },
    "/v4/rooms/{roomId}": {
      "get": {
        "security": [{ "guestToken": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "roomId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Персональный snapshot",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Snapshot" } }
            }
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Error" } }
            }
          }
        }
      }
    },
    "/v4/rooms/{roomId}/commands": {
      "post": {
        "security": [{ "guestToken": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "roomId",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/V4Command" } }
          }
        },
        "responses": {
          "201": {
            "description": "Принято",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Ack" } }
            }
          },
          "default": {
            "description": "Ошибка",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/V4Error" } }
            }
          }
        }
      }
    }
  },
