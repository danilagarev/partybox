            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "location": { "type": "string", "minLength": 1 },
          "suspectId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "winner": { "enum": ["spy", "civilians"] }
        },
        "required": ["spyId", "location", "suspectId", "winner"]
      },
      "V4View": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "packId": { "type": "string" },
          "packVersion": { "type": "integer", "minimum": 1 },
          "phase": { "enum": ["distribution", "discussion", "voting", "results"] },
          "readyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 12
          },
          "deadline": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "result": { "oneOf": [{ "$ref": "#/components/schemas/V4Result" }, { "type": "null" }] }
        },
        "required": [
          "sessionId",
          "packId",
          "packVersion",
          "phase",
          "readyIds",
          "deadline",
          "result"
        ]
      },
      "V4Card": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": { "role": { "const": "spy" }, "location": { "type": "null" } },
            "required": ["role", "location"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": { "const": "civilian" },
              "location": { "type": "string", "minLength": 1 }
            },
            "required": ["role", "location"]
          }
        ]
      },
      "V4Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": { "const": 4 },
          "roomId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "version": { "type": "integer", "minimum": 1 },
          "serverTime": { "type": "string" },
          "publicState": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": { "const": "lobby" },
              "pin": { "type": "string", "pattern": "^[0-9]{6}$" },
              "hostId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "expiresAt": { "type": "string" },
              "players": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "$ref": "#/components/schemas/V4Player" }
              },
              "game": { "oneOf": [{ "$ref": "#/components/schemas/V4View" }, { "type": "null" }] },
              "tolerance": {
                "oneOf": [{ "$ref": "#/components/schemas/TolerancePublic" }, { "type": "null" }]
              },
              "clues": {
                "oneOf": [{ "$ref": "#/components/schemas/CluesPublic" }, { "type": "null" }]
              }
            },
            "required": [
              "phase",
              "pin",
              "hostId",
              "expiresAt",
              "players",
              "game",
              "tolerance",
              "clues"
            ]
          },
          "privateState": {
            "oneOf": [{ "$ref": "#/components/schemas/V4Card" }, { "type": "null" }]
          },
          "selfId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "privateTolerance": {
            "oneOf": [{ "$ref": "#/components/schemas/PrivateTolerance" }, { "type": "null" }]
          },
          "privateClues": {
            "oneOf": [{ "$ref": "#/components/schemas/PrivateClues" }, { "type": "null" }]
          }
        },
        "required": [
          "protocolVersion",
          "roomId",
          "version",
          "serverTime",
          "publicState",
          "privateState",
          "selfId",
          "privateTolerance",
          "privateClues"
        ]
      },
      "V4EnrollmentResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "guestToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "snapshot": { "$ref": "#/components/schemas/V4Snapshot" }
        },
        "required": ["guestToken", "snapshot"]
      },
      "V4Ack": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": { "const": 4 },
          "commandId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "accepted": { "const": true },
          "version": { "type": "integer", "minimum": 1 }
        },
        "required": ["protocolVersion", "commandId", "accepted", "version"]
      },
      "V4Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": { "const": 4 },
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "ROOM_UNAVAILABLE",
              "ROOM_EXPIRED",
              "ROOM_FULL",
              "ROOM_CLOSED",
              "VERSION_CONFLICT",
              "COMMAND_CONFLICT",
              "RATE_LIMITED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "FORBIDDEN",
              "INVALID_PHASE",
              "ROOM_IN_PROGRESS",
              "SESSION_CONFLICT",
              "CLIENT_UPGRADE_REQUIRED"
            ]
          }
        },
        "required": ["protocolVersion", "code"]
      },
      "ToleranceCard": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^tolerance-[0-9]{2}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "required": ["id", "text"]
      },
      "ToleranceGuess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "position": { "type": "integer", "minimum": 0, "maximum": 3 },
          "correct": { "type": "boolean" }
        },
        "required": ["playerId", "position", "correct"]
      },
      "ToleranceResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "array",
            "items": { "type": "string", "pattern": "^tolerance-[0-9]{2}$" },
            "minItems": 4,
            "maxItems": 4
          },
          "guesses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToleranceGuess" },
            "minItems": 3,
            "maxItems": 11
          }
        },
        "required": ["order", "guesses"]
      },
      "ToleranceScore": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "score": { "type": "integer", "minimum": 0, "maximum": 11 }
        },
        "required": ["playerId", "score"]
      },
      "TolerancePublic": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "phase": { "enum": ["ranking", "guessing", "reveal", "finished"] },
          "roundIndex": { "type": "integer", "minimum": 0, "maximum": 11 },
          "heroId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "cards": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToleranceCard" },
            "minItems": 4,
            "maxItems": 4
          },
          "visibleOrder": {
            "type": "array",
            "items": { "type": "string", "pattern": "^tolerance-[0-9]{2}$" },
            "minItems": 0,
            "maxItems": 3
          },
          "targetId": { "type": "string", "pattern": "^tolerance-[0-9]{2}$" },
          "submittedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 11
          },
          "scores": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToleranceScore" },
            "minItems": 4,
            "maxItems": 12
          },
          "result": {
            "oneOf": [{ "$ref": "#/components/schemas/ToleranceResult" }, { "type": "null" }]
          },
          "winners": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 0,
            "maxItems": 12
          }
        },
        "required": [
          "sessionId",
          "phase",
          "roundIndex",
          "heroId",
          "cards",
          "visibleOrder",
          "targetId",
          "submittedIds",
          "scores",
          "result",
          "winners"
        ]
      },
      "PrivateTolerance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "string", "pattern": "^tolerance-[0-9]{2}$" },
                "minItems": 4,
                "maxItems": 4
              },
              { "type": "null" }
            ]
          },
          "guess": {
            "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 3 }, { "type": "null" }]
          }
        },
        "required": ["order", "guess"]
      },
      "CluesAnswer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "answer": { "oneOf": [{ "type": "string", "maxLength": 120 }, { "type": "null" }] },
          "correct": { "type": "boolean" },
          "points": { "type": "integer", "minimum": 0, "maximum": 4 }
        },
        "required": ["playerId", "answer", "correct", "points"]
      },
      "CluesResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": { "type": "string", "minLength": 1, "maxLength": 120 },
          "answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "$ref": "#/components/schemas/CluesAnswer" }
          }
        },
        "required": ["answer", "answers"]
      },
      "PrivateClues": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answer": { "oneOf": [{ "type": "string", "maxLength": 120 }, { "type": "null" }] },
          "clueIndex": {
            "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 3 }, { "type": "null" }]
          },
          "correct": { "type": "boolean" },
          "points": { "type": "integer", "minimum": 0, "maximum": 4 }
        },
        "required": ["answer", "clueIndex", "correct", "points"]
      },
      "CluesPublic": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "phase": { "enum": ["playing", "reveal", "finished"] },
          "roundIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
          "roundCount": { "const": 5 },
          "clueIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
          "clues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "solvedIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "attemptedIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "scores": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "playerId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "score": { "type": "integer", "minimum": 0, "maximum": 20 }
              },
              "required": ["playerId", "score"]
            }
          },
          "result": {
            "oneOf": [{ "$ref": "#/components/schemas/CluesResult" }, { "type": "null" }]
          },
          "winners": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "sessionId",
          "phase",
          "roundIndex",
          "roundCount",
          "clueIndex",
          "clues",
          "solvedIds",
          "attemptedIds",
          "scores",
          "result",
          "winners"
        ]
      }
    }
  }
}
