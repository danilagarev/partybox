{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://partybox.invalid/schemas/spy-catalog.v1.json",
  "title": "Bundled Spy catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "locale", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": { "const": "spy" },
    "locale": { "const": "ru" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
          "version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  }
}
