{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gameId": {
      "const": "tolerance"
    },
    "id": {
      "const": "tolerance-ru-base"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "ru"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 48,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tolerance-[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "required": ["id", "text"]
      }
    }
  },
  "required": ["schemaVersion", "gameId", "id", "version", "locale", "title", "items"]
}
